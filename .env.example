# Variable names only. Copy to .env and fill in real values; never commit .env.

# PostgreSQL connection string used by the app and Prisma. Required.
# Local: postgresql://USER:PASSWORD@127.0.0.1:5432/dive?schema=public
# Neon (Vercel): the POOLED string (host contains "-pooler") with "&pgbouncer=true" appended.
DATABASE_URL=

# Public address of the site, used in password-reset emails. Required in production.
APP_URL=

# Protects the scheduled housekeeping endpoint (/api/cron/settle). Vercel Cron sends it automatically.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Password-reset email. Production: set both. Local development: EMAIL_TRANSPORT=dev-outbox instead.
RESEND_API_KEY=
MAIL_FROM=
EMAIL_TRANSPORT=

# Optional: extra origins allowed to call the API with cookies (comma separated). Normally empty.
ALLOWED_ORIGINS=

# Optional: separate databases for the automated tests.
TEST_DATABASE_URL=
E2E_DATABASE_URL=
