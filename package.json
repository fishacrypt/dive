{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5173 -H 0.0.0.0",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "build": "prisma generate && next build",
    "start": "next start -p 5173",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "bun ./prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.2",
    "@circle-fin/app-kit": "^1.18.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@node-rs/argon2": "^2.2.2",
    "@node-rs/argon2-win32-x64-msvc": "2.2.2",
    "@openzeppelin/contracts": "5.6.1",
    "@prisma/client": "6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.62.7",
    "@web3icons/react": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "2.57.5",
    "wagmi": "^2.19.5",
    "zod": "3"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@playwright/test": "1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "prisma": "6",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "2"
  },
  "prisma": {
    "seed": "bun ./prisma/seed.ts"
  }
}
